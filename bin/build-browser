#!/usr/bin/env node

/**
 * Bundles the platform-independent parts of lib/ into jst.js for the browser,
 * so the compiler exists in exactly one place.
 */

var fs = require('fs'),
    path = require('path');

var root = path.join(__dirname, '..'),
    target = path.join(root, 'jst.js'),
    modules = ['./errors', './scope', './filters', './compiler'];

var banner = '/**\n'
  + ' * Node-jst for browsers\n'
  + ' * Copyright(c) 2011 Shaun Li <me@shaunli.com>\n'
  + ' * MIT Licensed\n'
  + ' *\n'
  + ' * Generated by bin/build-browser -- edit lib/ instead.\n'
  + ' */\n\n';

// A four-line module shim lets the lib/ sources be bundled verbatim.
function bundle() {
  var out = banner
    + ';(function(root) {\n\n'
    + '  var defs = {}, cache = {};\n\n'
    + '  function require(name) {\n'
    + '    if (!cache[name]) {\n'
    + '      var module = {exports: {}};\n'
    + '      cache[name] = module.exports;\n'
    + '      defs[name](module.exports, module, require);\n'
    + '      cache[name] = module.exports;\n'
    + '    }\n'
    + '    return cache[name];\n'
    + '  }\n\n';

  modules.forEach(function(name) {
    var src = fs.readFileSync(path.join(root, 'lib', name.substring(2) + '.js'), 'utf8');

    out += "  defs['" + name + "'] = function(exports, module, require) {\n"
      + src.replace(/^/gm, '    ').replace(/[ \t]+$/gm, '')
      + '\n  };\n\n';
  });

  return out + "  var jst = require('./compiler');\n\n"
    + "  if (typeof module !== 'undefined' && module.exports) module.exports = jst;\n"
    + "  else if (typeof define === 'function' && define.amd) define(function() { return jst; });\n"
    + "  else root.jst = jst;\n\n"
    + '})(typeof self !== \'undefined\' ? self : this);\n';
}

module.exports = bundle;

if (require.main === module) {
  var out = bundle();
  fs.writeFileSync(target, out);
  console.log('jst.js written (' + out.length + ' bytes)');
}
