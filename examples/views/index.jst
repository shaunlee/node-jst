{# Prefixing with `it.` lets the compiler skip with(it) -- see the Readme #}

<h1>{{ it.title }}</h1>
<p>Welcome to {{ it.title }}</p>

<h2>Code blocks</h2>
{% if (it.items.length) { %}
<ul>
  {% for (var i = 0; i < it.items.length; i++) { %}
  <li>{{ it.items[i] }}</li>
  {% } %}
</ul>
{% } else { %}
<p>Nothing to show.</p>
{% } %}

<h2>Filters</h2>
<p>{{ it.comment|e }}</p>
<p>{{ it.stars|add(1) }} stars</p>

<h2>Preformatted text survives minifying</h2>
<pre>
  one
    two
</pre>
